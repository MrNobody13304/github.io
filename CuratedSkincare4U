<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Aura Skincare</title>

  <style>
    :root {
      --burnt-orange: #A95320;
      --cream: #F1F0EE;
      --brown: #6A3515;
      --deep-green: #1B312F;
      --dark-green: #040D08;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "Helvetica Neue", sans-serif;
    }

    body {
      background: var(--cream);
      color: var(--dark-green);
      line-height: 1.6;
    }

    header {
      min-height: 100vh;
      background: linear-gradient(
        rgba(4,13,8,0.5),
        rgba(4,13,8,0.5)
      ),
      url("https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd");
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--cream);
    }

    header h1 {
      font-size: 3rem;
      letter-spacing: 2px;
      animation: fadeDown 1.5s ease;
    }

    header p {
      margin-top: 1rem;
      font-size: 1.1rem;
      animation: fadeUp 1.8s ease;
    }

    section {
      padding: 4rem 10%;
    }

    .fade {
      opacity: 0;
      transform: translateY(30px);
      transition: all 1s ease;
    }

    .fade.show {
      opacity: 1;
      transform: translateY(0);
    }

    .about {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .about img {
      width: 100%;
      border-radius: 12px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }

    .product {
      background: white;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      transition: transform 0.4s ease;
    }

    .product:hover {
      transform: translateY(-8px);
    }

    .product img {
      width: 100%;
      height: 280px;
      object-fit: cover;
    }

    .product div {
      padding: 1.5rem;
    }

    footer {
      background: var(--deep-green);
      color: var(--cream);
      padding: 3rem 10%;
      text-align: center;
    }

    footer a {
      color: var(--burnt-orange);
      text-decoration: none;
      font-weight: bold;
    }

    @keyframes fadeDown {
      from { opacity: 0; transform: translateY(-30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media(max-width: 768px) {
      .about {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

<header>
  <div>
    <h1>AURA SKINCARE</h1>
    <p>Intentional beauty. Gentle rituals. Timeless glow.</p>
  </div>
</header>

<section class="fade">
  <div class="about">
    <div>
      <h2>Our Philosophy</h2>
      <p>
        Aura Skincare is rooted in simplicity, balance, and mindful beauty.
        We believe skincare should feel calm, nourishing, and deeply personal.
      </p>
    </div>
    <img src="https://images.unsplash.com/photo-1600185365483-26d7a4cc7519" alt="Skincare model">
  </div>
</section>

<section class="fade">
  <h2 style="margin-bottom:2rem;">Featured Essentials</h2>
  <div class="products">
    <div class="product">
      <img src="https://images.unsplash.com/photo-1612817288484-6f916006741a" alt="Serum">
      <div>
        <h3>Botanical Glow Serum</h3>
        <p>Lightweight hydration for radiant, balanced skin.</p>
      </div>
    </div>

    <div class="product">
      <img src="https://images.unsplash.com/photo-1585238342028-4c1f9c91a9f3" alt="Cream">
      <div>
        <h3>Barrier Repair Cream</h3>
        <p>Deep nourishment for daily skin protection.</p>
      </div>
    </div>

    <div class="product">
      <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be" alt="Cleanser">
      <div>
        <h3>Gentle Cleanse</h3>
        <p>A calming cleanse for sensitive skin.</p>
      </div>
    </div>
  </div>
</section>

<footer>
  <p>Connect with us</p>
  <p>
    Pinterest: <a href="https://www.pinterest.com/AuraBrandID" target="_blank">@Aura BrandID</a><br>
    Email: <a href="mailto:aurabrandid@gmail.com">aurabrandid@gmail.com</a>
  </p>
</footer>

<script>
  const fades = document.querySelectorAll(".fade");

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add("show");
      }
    });
  }, { threshold: 0.2 });

  fades.forEach(fade => observer.observe(fade));
</script>

</body>
</html>
